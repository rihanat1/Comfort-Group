+import { FiChevronDown } from "react-icons/fi";
+
+// A dropdown with the label ABOVE the box (same look as LabeledInput).
+// Props: label, name, placeholder, value, onChange, options
+// options is a simple list of text, for example ["Cardiology", "Surgery"]
+const LabeledSelect = ({
+  label,
+  name,
+  placeholder,
+  value,
+  onChange,
+  options,
+}) => {
+  return (
+    <div className="w-full">
+      <label className="mb-1 block text-sm text-secondary/70">{label}</label>
+
+      <div className="relative">
+        <select
+          name={name}
+          value={value}
+          onChange={onChange}
+          // gray text while nothing is chosen yet, dark text after
+          className={`h-12 w-full appearance-none rounded-lg border border-secondary/50 bg-white px-4 pr-12 outline-none focus:border-buttonPrimary ${
+            value === "" ? "text-secondary/30" : "text-primary"
+          }`}
+        >
+          <option value="" disabled>
+            {placeholder}
+          </option>
+          {options.map((option) => (
+            <option key={option} value={option}>
+              {option}
+            </option>
+          ))}
+        </select>
+
+        {/* the little arrow on the right */}
+        <FiChevronDown className="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xl text-secondary/70" />
+      </div>
+    </div>
+  );
+};
+
+export default LabeledSelect;
diff --git a/src/Components/OtpBoxes.jsx b/src/Components/OtpBoxes.jsx
new file mode 100644
index 0000000..16a1815
--- /dev/null
+++ b/src/Components/OtpBoxes.jsx
@@ -0,0 +1,57 @@
+import { useRef } from "react";
+
+// Six boxes for a verification code, one digit per box.
+// Props:
+//   code     - a list of 6 items, for example ["1", "2", "", "", "", ""]
+//   onChange - runs with the new list when the user types or deletes
+//   onPaste  - runs with the pasted text when the user pastes into a box
+const OtpBoxes = ({ code, onChange, onPaste }) => {
+  // inputs.current[0] is the first box, [1] is the second ... so we can jump between them
+  const inputs = useRef([]);
+
+  const handleChange = (e, index) => {
+    // keep only the last digit typed, ignore letters
+    const digit = e.target.value.replace(/\D/g, "").slice(-1);
+
+    const newCode = [...code];
+    newCode[index] = digit;
+    onChange(newCode);
+
+    // after typing a digit, jump to the next box
+    if (digit && index < code.length - 1) {
+      inputs.current[index + 1].focus();
+    }
+  };
+
+  const handleKeyDown = (e, index) => {
+    // Backspace on an empty box = go back to the box before it
+    if (e.key === "Backspace" && code[index] === "" && index > 0) {
+      inputs.current[index - 1].focus();
+    }
+  };
+
+  const handlePaste = (e) => {
+    e.preventDefault();
+    onPaste(e.clipboardData.getData("text"));
+  };
+
+  return (
+    <div className="grid grid-cols-6 gap-2 sm:gap-6">
+      {code.map((digit, index) => (
+        <input
+          key={index}
+          ref={(el) => (inputs.current[index] = el)}
+          type="text"
+          inputMode="numeric"
+          value={digit}
+          onChange={(e) => handleChange(e, index)}
+          onKeyDown={(e) => handleKeyDown(e, index)}
+          onPaste={handlePaste}
+          className="h-14 w-full rounded-xl bg-[#d9d9d9] text-center text-2xl font-semibold text-primary outline-none focus:ring-2 focus:ring-buttonPrimary sm:h-[72px]"
+        />
+      ))}
+    </div>
+  );
+};
+
+export default OtpBoxes;
