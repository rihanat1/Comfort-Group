+             className="h-10 w-10 object-contain sm:h-10 sm:w-10"
+           />
+           <span className="text-sm font-bold text-primary min-[360px]:text-base min-[400px]:text-xl sm:text-2xl">
+             <span className="text-green">Comfort</span>Group
+           </span>
+          </div>
